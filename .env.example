# Local MongoDB for development — copy to `.env` (git-ignored) and adjust.
# `docker compose -f docker-compose.dev.yml` reads it automatically.
# See docs/development.md.

# Host port MongoDB is published on. Defaults to 27018 so it never collides
# with a MongoDB already running on 27017.
MONGO_PORT=27018

# Optional authentication. Leave both empty to run without auth (the default
# for local development). If you set them, use the same values in MONGO_URI
# below (mongodb://<user>:<password>@localhost:<port>).
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=

# Connection string the pipeline reads via coops.infrastructure.Settings.
# Adjust the port to match MONGO_PORT.
MONGO_URI=mongodb://localhost:27018
