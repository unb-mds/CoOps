# CoOps Dashboard Environment Variables

# Data Source Configuration
# - 'true': Uses local /data folder (copy data from ../data/ to public/data/ manually)
# - 'false': Fetches from GitHub directly
#
# IMPORTANT: Data JSON files should NOT be committed to the frontend repository!
# They are managed by the backend workflows and stored in the main repo's /data directory.
VITE_USE_LOCAL_DATA=false

# GitHub Data Source (automatically set in GitHub Actions)
# Format: https://raw.githubusercontent.com/{GITHUB_ORG}/{GITHUB_REPO}/main/data
#
# REQUIRED in remote mode. There is deliberately no default: without
# VITE_GITHUB_ORG the dashboard fails closed — it does not fetch anything and
# shows a "configure VITE_GITHUB_ORG" state instead of silently rendering a
# third party's data. Set it to YOUR organization name:
VITE_GITHUB_ORG=your-org-name
VITE_GITHUB_REPO=CoOps

# Repository Name (automatically set in GitHub Actions - do not set manually)
# VITE_REPO_NAME=CoOps
